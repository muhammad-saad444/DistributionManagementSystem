rules_version = '2';

// Who can read and write what.
//
//   Super admin (depotOS)  – listed in platform_admins/{uid}, which only the Firebase console can
//                            create. Sees and manages every company.
//   Company admin / owner  – manages their own company's people and data.
//   Employee (booker)      – uses their own company's data.
//
// Each company's data lives in companies/{companyId}/{collection}/…, and only that company's active
// members (and the super admin) can reach it, only for the modules the super admin switched on.
// The original company's data is in the shared top-level collections until the super admin moves
// it (companies/an-agency.legacyData becomes false); after that only the super admin can read the
// old copy.
//
// Deploy with:  firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function myEmail() { return request.auth.token.email.lower(); }
    function isSuper() { return signedIn() && exists(/databases/$(database)/documents/platform_admins/$(request.auth.uid)); }

    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function hasProfile() { return signedIn() && exists(userPath(request.auth.uid)); }
    function me() { return get(userPath(request.auth.uid)).data; }
    function isActive() { return hasProfile() && me().status == 'active' && me().companyId != null; }
    function inCompany(c) { return isActive() && me().companyId == c; }
    function isAdmin() { return isActive() && me().role in ['owner', 'admin']; }
    function isAdminOf(c) { return isAdmin() && me().companyId == c; }

    function companyPath(c) { return /databases/$(database)/documents/companies/$(c); }
    function companyData(c) { return get(companyPath(c)).data; }
    function hasModule(c, m) { return companyData(c).modules[m] == true; }
    // An active member of an active company.
    function member(c) { return inCompany(c) && companyData(c).status == 'active'; }

    // Which module each collection belongs to; everything else is always available.
    function moduleAllows(c, coll) {
      return (!(coll in ['crm_visits', 'crm_followups']) || hasModule(c, 'crm'))
          && (!(coll in ['purchases', 'supplier_payments', 'stock_moves']) || hasModule(c, 'purchases'))
          && (!(coll in ['booker_credits', 'customer_recoveries']) || hasModule(c, 'khata'))
          // shop balances are part of both Khata and CRM
          && (coll != 'khata_entries' || hasModule(c, 'khata') || hasModule(c, 'crm'))
          && (coll != 'dsr_reports' || hasModule(c, 'dsr'))
          // the stock screen reads load sheets too
          && (coll != 'load_sheets' || hasModule(c, 'loadsheet') || hasModule(c, 'purchases'));
    }

    // The original single company, while its data is still in the shared collections.
    function legacyCompany() { return companyPath('an-agency'); }
    function beforeSetup() { return !exists(legacyCompany()); }
    function legacyMember() {
      return inCompany('an-agency') && get(legacyCompany()).data.legacyData == true;
    }

    // ---------------------------------------------------------------- super admins
    match /platform_admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false; // only from the Firebase console
    }

    // ---------------------------------------------------------------- companies
    match /companies/{c} {
      // Members read their company. Anyone signed in may look up a company that doesn't exist yet.
      allow get: if isSuper() || inCompany(c) || (signedIn() && resource == null);
      allow list: if isSuper();
      allow create: if isSuper()
                    // one-time setup of the original company by its original admin login
                    || (c == 'an-agency'
                        && signedIn()
                        && myEmail() == 'admin@gmail.com'
                        && request.resource.data.ownerUid == request.auth.uid
                        && request.resource.data.status == 'active'
                        && request.resource.data.legacyData == true);
      // Admins may rename their company; status, modules and limits are the super admin's.
      allow update: if isSuper()
                    || (isAdminOf(c) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']));
      allow delete: if false;

      // The company's own login copies: members read all (the app lists people from them),
      // each writes only their own.
      match /sessions/{uid} {
        allow read: if isSuper() || member(c);
        allow write: if isSuper() || (member(c) && request.auth.uid == uid);
      }

      // All of the company's business data.
      match /{coll}/{document=**} {
        allow read: if isSuper() || (member(c) && moduleAllows(c, coll));
        allow write: if isSuper() || (member(c) && coll != 'sessions' && moduleAllows(c, coll));
      }
    }

    // ---------------------------------------------------------------- users
    match /users/{uid} {
      function sameRoleOrLess() { return request.resource.data.role in ['admin', 'booker']; }
      function onlyChanged(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
      // Super admin sees everyone.
      allow get: if signedIn() && (request.auth.uid == uid || isSuper());
      allow list: if isSuper();
      // Company admins see only their own company's people.
      allow get, list: if isAdmin() && resource.data.companyId == me().companyId;

      allow create: if signedIn() && (
          // Admins create every account; nobody creates their own (except the one-time setup below).
          isSuper()
          // The original admin becomes owner while creating the company in the same batch.
          || (request.auth.uid == uid
            && request.resource.data.role == 'owner'
            && request.resource.data.status == 'active'
            && request.resource.data.companyId == 'an-agency'
            && beforeSetup()
            && getAfter(legacyCompany()).data.ownerUid == request.auth.uid)
          // An admin adds someone to their company (never as owner).
          || (isAdminOf(request.resource.data.companyId) && sameRoleOrLess())
        );

      allow update: if signedIn() && (
          isSuper()
          // Your own name and email only, never your role, status or company.
          || (request.auth.uid == uid && onlyChanged(['name', 'email']))
          // An admin changes someone else in their company (not the owner, not themselves).
          || (request.auth.uid != uid
            && isAdminOf(resource.data.companyId)
            && request.resource.data.companyId == resource.data.companyId
            && resource.data.role != 'owner'
            && sameRoleOrLess())
        );

      allow delete: if false;
    }

    // ---------------------------------------------------------------- login sessions
    match /sessions/{uid} {
      // Written at every login, before the app knows the user's company.
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // ---------------------------------------------------------------- the old shared collections
    // Before the original company is set up: anyone signed in, as it always was. Then only its
    // active members, until its data is moved. After that only the super admin (as a backup).
    match /{coll}/{document=**} {
      allow read, write: if signedIn()
                         && coll in ['areas', 'booker_credits', 'crm_followups', 'crm_visits',
                                     'customer_recoveries', 'customers', 'dsr_reports', 'invoices',
                                     'khata_entries', 'load_sheets', 'products', 'purchases',
                                     'sessions', 'settings', 'stock_moves', 'supplier_payments',
                                     'suppliers', 'user_areas', 'user_customers']
                         && (beforeSetup() || isSuper() || legacyMember());
    }
  }
}
