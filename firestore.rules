rules_version = '2';

// Who can read and write what.
//
//   Super admin (depotOS)  – listed in platform_admins/{uid}, which only the Firebase console can
//                            create. Sees and manages every company.
//   Company admin / owner  – manages their own company's people and data.
//   Employee (booker)      – uses their own company's data.
//
// Each company's data lives in companies/{companyId}/{collection}/…, and only that company's active
// members (and the super admin) can reach it, only for the modules the super admin switched on.
// The original company's data is in the shared top-level collections until the super admin moves
// it (companies/an-agency.legacyData becomes false); after that only the super admin can read the
// old copy.
//
// Deploy with:  firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function myEmail() { return request.auth.token.email.lower(); }
    function isSuper() { return signedIn() && exists(/databases/$(database)/documents/platform_admins/$(request.auth.uid)); }

    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function hasProfile() { return signedIn() && exists(userPath(request.auth.uid)); }
    function me() { return get(userPath(request.auth.uid)).data; }
    function isActive() { return hasProfile() && me().status == 'active' && me().companyId != null; }
    function inCompany(c) { return isActive() && me().companyId == c; }
    function isAdmin() { return isActive() && me().role in ['owner', 'admin']; }
    function isAdminOf(c) { return isAdmin() && me().companyId == c; }

    function companyPath(c) { return /databases/$(database)/documents/companies/$(c); }
    function companyData(c) { return get(companyPath(c)).data; }
    function hasModule(c, m) { return companyData(c).modules[m] == true; }
    // An active member of an active company.
    function member(c) { return inCompany(c) && companyData(c).status == 'active'; }

    // Which module each collection belongs to; everything else is always available.
    function moduleAllows(c, coll) {
      return (!(coll in ['crm_visits', 'crm_followups']) || hasModule(c, 'crm'))
          && (!(coll in ['purchases', 'supplier_payments', 'stock_moves', 'quotations', 'purchase_orders']) || hasModule(c, 'purchases'))
          && (!(coll in ['booker_credits', 'customer_recoveries']) || hasModule(c, 'khata'))
          // shop balances are part of both Khata and CRM
          && (coll != 'khata_entries' || hasModule(c, 'khata') || hasModule(c, 'crm'))
          && (coll != 'dsr_reports' || hasModule(c, 'dsr'))
          // the stock screen reads load sheets too
          && (coll != 'load_sheets' || hasModule(c, 'loadsheet') || hasModule(c, 'purchases'));
    }


    // ---------------------------------------------------------------- HR (the "hr" module)
    // Salaries, advances and personal records are for admins only. A booker reaches just their own
    // link, attendance, leave requests and payslips. [legacy]: the original company's shared copy.
    function privateColls() {
      return ['employees', 'advances', 'payroll', 'payslips', 'hr_links', 'attendance', 'leave_requests',
              'sales_orders', 'expenses', 'cash_entries', 'returns', 'targets'];
    }
    function hrIn(c, legacy) {
      return hasModule(c, 'hr') && ((legacy && legacyMember()) || (!legacy && member(c)));
    }
    function hrAdmin(c, legacy) { return isSuper() || (hrIn(c, legacy) && isAdminOf(c)); }
    function mine(data) { return data.userUid == request.auth.uid; }
    function sameOwner() {
      return request.resource.data.userUid == resource.data.userUid
          && request.resource.data.employeeId == resource.data.employeeId;
    }
    // A booker checks in and out for themselves; a day an admin marked is the admin's.
    function selfAttendance(c, legacy) {
      return hrIn(c, legacy) && mine(request.resource.data) && request.resource.data.markedBy == 'self'
          && request.resource.data.get('status', 'present') in ['present', 'late']
          && (resource == null || (mine(resource.data) && resource.data.markedBy == 'self' && sameOwner()));
    }
    // A booker applies for leave and may cancel it while it's pending.
    function selfLeaveCreate(c, legacy) {
      return hrIn(c, legacy) && mine(request.resource.data) && request.resource.data.status == 'pending';
    }
    function selfLeaveCancel(c, legacy) {
      return hrIn(c, legacy) && mine(resource.data) && resource.data.status == 'pending'
          && request.resource.data.status == 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
    }


    // ---------------------------------------------------------------- sales orders
    // Everyone in the company sees them; a booker places their own and may cancel it while it's
    // pending; only admins approve or reject.
    function soIn(c, legacy) { return (legacy && legacyMember()) || (!legacy && member(c)); }
    function soAdmin(c, legacy) { return isSuper() || (soIn(c, legacy) && isAdminOf(c)); }
    function soCreate(c, legacy) {
      return soIn(c, legacy) && request.resource.data.userId == request.auth.uid
          && request.resource.data.status == 'pending';
    }
    // Company expenses (rent, fuel, wages...): money matters, admins only.
    function expAdmin(c, legacy) {
      return isSuper() || (((legacy && legacyMember()) || (!legacy && member(c))) && isAdminOf(c));
    }
    function soCancel(c, legacy) {
      return soIn(c, legacy) && resource.data.userId == request.auth.uid && resource.data.status == 'pending'
          && request.resource.data.status == 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
    }

    // The original single company, while its data is still in the shared collections.
    function legacyCompany() { return companyPath('an-agency'); }
    function beforeSetup() { return !exists(legacyCompany()); }
    function legacyMember() {
      return inCompany('an-agency') && get(legacyCompany()).data.legacyData == true;
    }

    // ---------------------------------------------------------------- super admins
    match /platform_admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false; // only from the Firebase console
    }

    // ---------------------------------------------------------------- companies
    match /companies/{c} {
      // Members read their company. Anyone signed in may look up a company that doesn't exist yet.
      allow get: if isSuper() || inCompany(c) || (signedIn() && resource == null);
      allow list: if isSuper();
      allow create: if isSuper()
                    // one-time setup of the original company by its original admin login
                    || (c == 'an-agency'
                        && signedIn()
                        && myEmail() == 'admin@gmail.com'
                        && request.resource.data.ownerUid == request.auth.uid
                        && request.resource.data.status == 'active'
                        && request.resource.data.legacyData == true);
      // Admins may rename their company; status, modules and limits are the super admin's.
      allow update: if isSuper()
                    || (isAdminOf(c) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']));
      allow delete: if false;

      // The company's own login copies: members read all (the app lists people from them),
      // each writes only their own.
      match /sessions/{uid} {
        allow read: if isSuper() || member(c);
        allow write: if isSuper() || (member(c) && request.auth.uid == uid);
      }

      match /employees/{d} { allow read, write: if hrAdmin(c, false); }
      match /advances/{d} { allow read, write: if hrAdmin(c, false); }
      match /payroll/{d} { allow read, write: if hrAdmin(c, false); }
      match /payslips/{d} {
        allow read: if hrAdmin(c, false) || (hrIn(c, false) && mine(resource.data));
        allow write: if hrAdmin(c, false);
      }
      match /hr_links/{uid} {
        allow read: if hrAdmin(c, false) || (hrIn(c, false) && request.auth.uid == uid);
        allow write: if hrAdmin(c, false);
      }
      match /attendance/{d} {
        allow read: if hrAdmin(c, false) || (hrIn(c, false) && (resource == null || mine(resource.data)));
        allow create, update: if hrAdmin(c, false) || selfAttendance(c, false);
        allow delete: if hrAdmin(c, false);
      }
      match /leave_requests/{d} {
        allow read: if hrAdmin(c, false) || (hrIn(c, false) && mine(resource.data));
        allow create: if hrAdmin(c, false) || selfLeaveCreate(c, false);
        allow update: if hrAdmin(c, false) || selfLeaveCancel(c, false);
        allow delete: if hrAdmin(c, false);
      }

      match /sales_orders/{d} {
        allow read: if isSuper() || soIn(c, false);
        allow create: if soAdmin(c, false) || soCreate(c, false);
        allow update: if soAdmin(c, false) || soCancel(c, false);
        allow delete: if soAdmin(c, false);
      }

      match /expenses/{d} { allow read, write: if expAdmin(c, false); }
      match /cash_entries/{d} { allow read, write: if expAdmin(c, false); }
      // Goods back from shops: only the office records them (it changes the bill and stock).
      match /returns/{d} { allow read, write: if expAdmin(c, false); }
      // Monthly targets: the office sets them; a booker reads only their own.
      match /targets/{d} {
        allow read: if expAdmin(c, false)
                    || (member(c) && (resource == null || resource.data.userId == request.auth.uid));
        allow write: if expAdmin(c, false);
      }

      // All of the company's business data.
      match /{coll}/{document=**} {
        allow read: if !(coll in privateColls()) && (isSuper() || (member(c) && moduleAllows(c, coll)));
        allow write: if !(coll in privateColls()) && (isSuper() || (member(c) && coll != 'sessions' && moduleAllows(c, coll)));
      }
    }

    // ---------------------------------------------------------------- users
    match /users/{uid} {
      function sameRoleOrLess() { return request.resource.data.role in ['admin', 'booker']; }
      function onlyChanged(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
      // Super admin sees everyone.
      allow get: if signedIn() && (request.auth.uid == uid || isSuper());
      allow list: if isSuper();
      // Company admins see only their own company's people.
      allow get, list: if isAdmin() && resource.data.companyId == me().companyId;

      allow create: if signedIn() && (
          // Admins create every account; nobody creates their own (except the one-time setup below).
          isSuper()
          // The original admin becomes owner while creating the company in the same batch.
          || (request.auth.uid == uid
            && request.resource.data.role == 'owner'
            && request.resource.data.status == 'active'
            && request.resource.data.companyId == 'an-agency'
            && beforeSetup()
            && getAfter(legacyCompany()).data.ownerUid == request.auth.uid)
          // An admin adds someone to their company (never as owner).
          || (isAdminOf(request.resource.data.companyId) && sameRoleOrLess())
        );

      allow update: if signedIn() && (
          isSuper()
          // Your own name and email only, never your role, status or company.
          || (request.auth.uid == uid && onlyChanged(['name', 'email']))
          // An admin changes someone else in their company (not the owner, not themselves).
          || (request.auth.uid != uid
            && isAdminOf(resource.data.companyId)
            && request.resource.data.companyId == resource.data.companyId
            && resource.data.role != 'owner'
            && sameRoleOrLess())
        );

      allow delete: if false;
    }

    // ---------------------------------------------------------------- login sessions
    match /sessions/{uid} {
      // Written at every login, before the app knows the user's company.
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // ---------------------------------------------------------------- HR, original company's shared copy
    function legacyC() { return 'an-agency'; }
    match /employees/{d} { allow read, write: if hrAdmin(legacyC(), true); }
    match /advances/{d} { allow read, write: if hrAdmin(legacyC(), true); }
    match /payroll/{d} { allow read, write: if hrAdmin(legacyC(), true); }
    match /payslips/{d} {
      allow read: if hrAdmin(legacyC(), true) || (hrIn(legacyC(), true) && mine(resource.data));
      allow write: if hrAdmin(legacyC(), true);
    }
    match /hr_links/{uid} {
      allow read: if hrAdmin(legacyC(), true) || (hrIn(legacyC(), true) && request.auth.uid == uid);
      allow write: if hrAdmin(legacyC(), true);
    }
    match /attendance/{d} {
      allow read: if hrAdmin(legacyC(), true) || (hrIn(legacyC(), true) && (resource == null || mine(resource.data)));
      allow create, update: if hrAdmin(legacyC(), true) || selfAttendance(legacyC(), true);
      allow delete: if hrAdmin(legacyC(), true);
    }
    match /leave_requests/{d} {
      allow read: if hrAdmin(legacyC(), true) || (hrIn(legacyC(), true) && mine(resource.data));
      allow create: if hrAdmin(legacyC(), true) || selfLeaveCreate(legacyC(), true);
      allow update: if hrAdmin(legacyC(), true) || selfLeaveCancel(legacyC(), true);
      allow delete: if hrAdmin(legacyC(), true);
    }

    match /sales_orders/{d} {
      allow read: if isSuper() || soIn(legacyC(), true);
      allow create: if soAdmin(legacyC(), true) || soCreate(legacyC(), true);
      allow update: if soAdmin(legacyC(), true) || soCancel(legacyC(), true);
      allow delete: if soAdmin(legacyC(), true);
    }

    match /expenses/{d} { allow read, write: if expAdmin(legacyC(), true); }
    match /cash_entries/{d} { allow read, write: if expAdmin(legacyC(), true); }
    match /returns/{d} { allow read, write: if expAdmin(legacyC(), true); }
    match /targets/{d} {
      allow read: if expAdmin(legacyC(), true)
                  || (legacyMember() && (resource == null || resource.data.userId == request.auth.uid));
      allow write: if expAdmin(legacyC(), true);
    }

    // ---------------------------------------------------------------- the old shared collections
    // Before the original company is set up: anyone signed in, as it always was. Then only its
    // active members, until its data is moved. After that only the super admin (as a backup).
    match /{coll}/{document=**} {
      allow read, write: if signedIn()
                         && coll in ['areas', 'booker_credits', 'crm_followups', 'crm_visits',
                                     'customer_recoveries', 'customers', 'dsr_reports', 'invoices',
                                     'khata_entries', 'load_sheets', 'products', 'purchase_orders', 'purchases', 'quotations',
                                     'sessions', 'settings', 'stock_moves', 'supplier_payments',
                                     'suppliers', 'user_areas', 'user_customers', 'warehouses']
                         && (beforeSetup() || isSuper() || legacyMember());
    }
  }
}
